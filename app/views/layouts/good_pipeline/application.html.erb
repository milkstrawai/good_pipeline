<% theme = %w[dark light].include?(cookies[:good_pipeline_theme]) ? cookies[:good_pipeline_theme] : "dark" %>
<!doctype html>
<html lang="en" data-gp-theme="<%= theme %>">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    <meta name="good-pipeline-theme-url" content="<%= theme_path %>">
    <meta name="turbo-visit-control" content="reload">
    <title>GoodPipeline</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%23111317'/%3E%3Ctext x='5' y='22' fill='%23e6e9ef' font-family='monospace' font-size='16'%3Egp%3C/text%3E%3C/svg%3E">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&amp;family=JetBrains+Mono:wght@400;500&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" href="<%= frontend_static_path(id: "dashboard", format: :css) %>">
    <script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js" defer nonce="<%= content_security_policy_nonce %>"></script>
    <script src="<%= frontend_static_path(id: "dashboard", format: :js) %>" defer nonce="<%= content_security_policy_nonce %>"></script>
  </head>
  <body>
    <% if flash[:alert].present? || flash[:notice].present? %>
      <div class="gp-flash gp-flash--<%= flash[:alert].present? ? "alert" : "notice" %>" role="<%= flash[:alert].present? ? "alert" : "status" %>">
        <span class="gp-flash-text"><%= flash[:alert].presence || flash[:notice] %></span>
        <button type="button" class="gp-flash-close" data-gp-flash-dismiss aria-label="Dismiss">&times;</button>
      </div>
    <% end %>
    <%= yield %>
    <div id="gp-aria-live" class="gp-sr-only" aria-live="polite" aria-atomic="true"></div>
  </body>
</html>
