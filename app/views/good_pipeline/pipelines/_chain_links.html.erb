<% upstream = pipeline.upstream_pipelines.to_a; downstream = pipeline.downstream_pipelines.to_a %>
<% if upstream.any? || downstream.any? %>
  <section class="gp-card">
    <h3 class="gp-section-heading">chain</h3>
    <div class="gp-chain">
      <% upstream.each do |item| %>
        <%= link_to pipeline_path(item), class: "gp-chain-chip", title: "Upstream execution" do %>
          <span class="gp-chain-arrow">←</span><span><%= respond_to?(:short_type) ? short_type(item.type) : humanized_type(item.type) %></span><span class="gp-status gp-status--<%= item.status %>"><%= item.status %></span>
        <% end %>
      <% end %>
      <% downstream.each do |item| %>
        <%= link_to pipeline_path(item), class: "gp-chain-chip", title: "Downstream execution" do %>
          <span><%= respond_to?(:short_type) ? short_type(item.type) : humanized_type(item.type) %></span><span class="gp-status gp-status--<%= item.status %>"><%= item.status %></span><span class="gp-chain-arrow">→</span>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
